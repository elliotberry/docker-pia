#!/usr/bin/env bash
# Docker Hub automated-build hook. $IMAGE_NAME is injected by Docker Hub so the tag is correct.

set -euo pipefail
cd "$(dirname "$0")/.."

docker build \
  --build-arg VCS_REF="$(git rev-parse --short HEAD)" \
  --build-arg BUILD_DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --build-arg VERSION="$(cat VERSION)" \
  -t "${IMAGE_NAME:-wiorca/docker-pia:dev}" .
